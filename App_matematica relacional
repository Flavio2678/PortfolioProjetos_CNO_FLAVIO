<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:var(--font-sans);font-size:14px;color:#e8f0fe;background:#0a1628}
:root{--blue-dark:#0a1628;--blue-mid:#112244;--blue-accent:#1a4fa8;--blue-bright:#2979ff;--green:#39e07a;--green-dark:#1db954;--silver:#8aaac8;--border:#1e3a5f;--text-main:#e8f0fe;--text-muted:#6b8cba}

.wrap{min-height:100vh;background:#0a1628}

/* HEADER */
.header{background:linear-gradient(135deg,#061020 0%,#0d2045 50%,#061020 100%);border-bottom:1px solid #1e3a5f;padding:0;position:relative;overflow:hidden}
.header-circuit{position:absolute;inset:0;opacity:.07;background-image:repeating-linear-gradient(0deg,transparent,transparent 28px,#39e07a 28px,#39e07a 29px),repeating-linear-gradient(90deg,transparent,transparent 28px,#39e07a 28px,#39e07a 29px)}
.header-inner{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;padding:1rem 1.5rem}
.logo-area{display:flex;align-items:center;gap:14px}
.logo-badge{position:relative;width:52px;height:52px;border-radius:50%;background:linear-gradient(135deg,#1a4fa8,#0d2045);border:2px solid #2979ff;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.logo-badge svg{width:32px;height:32px}
.logo-text h1{font-size:20px;font-weight:700;color:#fff;letter-spacing:.04em;line-height:1}
.logo-text p{font-size:11px;color:#39e07a;letter-spacing:.12em;text-transform:uppercase;margin-top:3px}
.header-tag{font-size:11px;color:var(--text-muted);background:#112244;border:0.5px solid #1e3a5f;border-radius:20px;padding:4px 12px;letter-spacing:.05em}

/* NAV */
.nav{display:flex;gap:2px;padding:.75rem 1.5rem;background:#061020;border-bottom:1px solid #1e3a5f}
.nav-btn{padding:7px 18px;border-radius:20px;border:0.5px solid transparent;background:transparent;cursor:pointer;font-size:13px;color:var(--text-muted);transition:all .18s;letter-spacing:.02em}
.nav-btn:hover{color:#e8f0fe;background:#112244}
.nav-btn.active{background:#1a4fa8;border-color:#2979ff;color:#fff;font-weight:500}

/* CONTENT */
.content{padding:1.25rem 1.5rem 2.5rem}

/* CARDS */
.card{background:#0d1e38;border:0.5px solid #1e3a5f;border-radius:12px;padding:1.1rem 1.25rem;margin-bottom:.85rem}
.card-accent{border-left:3px solid #2979ff}
.lbl{font-size:10px;font-weight:600;color:#39e07a;text-transform:uppercase;letter-spacing:.1em;margin-bottom:.7rem}

/* OP PILLS */
.ops-grid{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:1rem}
.op-pill{display:flex;align-items:center;gap:6px;padding:6px 14px;border:0.5px solid #1e3a5f;border-radius:20px;background:#0a1628;cursor:pointer;font-size:13px;color:var(--text-muted);transition:all .18s}
.op-pill:hover{border-color:#2979ff;color:#e8f0fe;background:#112244}
.op-pill.active{background:linear-gradient(135deg,#1a4fa8,#113a80);border-color:#2979ff;color:#fff;font-weight:500}
.op-pill.active .op-sym{color:#39e07a}
.op-sym{font-size:16px;width:18px;text-align:center;color:#2979ff}

/* FORM */
.form-row{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:.75rem}
input,select{height:36px;padding:0 12px;border:0.5px solid #1e3a5f;border-radius:8px;background:#061020;color:#e8f0fe;font-size:13px;outline:none;transition:border .15s}
input::placeholder{color:#3a5a7a}
input:focus,select:focus{border-color:#2979ff}
input{min-width:180px;flex:1}
select{min-width:130px}
select option{background:#0a1628}
.run-btn{height:36px;padding:0 18px;background:linear-gradient(135deg,#1a4fa8,#2979ff);border:none;border-radius:8px;cursor:pointer;font-size:13px;font-weight:600;color:#fff;white-space:nowrap;transition:opacity .15s;letter-spacing:.02em}
.run-btn:hover{opacity:.88}
.op-desc{font-size:12px;color:var(--text-muted);line-height:1.6;margin-bottom:.1rem}
.hint-txt{font-size:12px;color:#3a5a7a;margin-top:.5rem;font-style:italic}
.sym-sep{font-size:20px;color:#2979ff;padding:0 6px}

/* EXPR */
.expr-chip{display:inline-flex;align-items:center;gap:8px;background:#061020;border:0.5px solid #1e3a5f;border-radius:20px;padding:5px 14px;font-family:var(--font-mono);font-size:12px;color:#39e07a;margin-bottom:.75rem}
.expr-label{font-size:10px;color:var(--text-muted);text-transform:uppercase;letter-spacing:.08em}

/* BADGES */
.badge{display:inline-block;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600;letter-spacing:.03em}
.b-ok{background:#0d3320;color:#39e07a;border:0.5px solid #1db954}
.b-err{background:#2a0a0a;color:#ff6b6b;border:0.5px solid #cc3333}
.b-cnt{background:#0a1e3a;color:#60a5fa;border:0.5px solid #1a4fa8}

/* TABLE */
table{width:100%;border-collapse:collapse;font-size:13px}
th{font-weight:600;padding:8px 12px;text-align:left;border-bottom:1px solid #1e3a5f;font-size:11px;color:#39e07a;text-transform:uppercase;letter-spacing:.06em;background:#061020}
td{padding:8px 12px;border-bottom:0.5px solid #0d1e38;color:#c8d8ee}
tr:hover td{background:#112244}
tr:last-child td{border-bottom:none}
.tbl-wrap{overflow-x:auto;border-radius:10px;border:0.5px solid #1e3a5f;background:#061020}

/* SCHEMA */
.schema-card{background:#0d1e38;border:0.5px solid #1e3a5f;border-radius:12px;overflow:hidden;margin-bottom:.85rem}
.schema-head{padding:.75rem 1.1rem;display:flex;align-items:center;gap:10px;background:#061020;border-bottom:0.5px solid #1e3a5f}
.schema-dot{width:10px;height:10px;border-radius:50%}
.schema-name{font-size:13px;font-weight:600;color:#e8f0fe}
.schema-count{font-size:11px;color:var(--text-muted);margin-left:4px}

/* EXERCISES */
.exer-item{display:flex;align-items:center;gap:12px;padding:.85rem 1.1rem;border:0.5px solid #1e3a5f;border-radius:12px;margin-bottom:.6rem;cursor:pointer;background:#0d1e38;transition:all .18s}
.exer-item:hover{border-color:#2979ff;background:#112244}
.exer-item.solved{border-color:#1db954;background:#0a1e14}
.exer-num{width:30px;height:30px;border-radius:50%;background:#061020;border:0.5px solid #1e3a5f;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600;color:var(--text-muted);flex-shrink:0}
.exer-num.done{background:#0d3320;border-color:#1db954;color:#39e07a}
.exer-info{flex:1}
.exer-title{font-weight:500;font-size:13px;color:#e8f0fe;margin-bottom:2px}
.exer-sub{font-size:12px;color:var(--text-muted)}
.arr{font-size:18px;color:#2979ff}
.detail-q{font-size:15px;font-weight:500;line-height:1.5;margin-bottom:.6rem;color:#e8f0fe}
.back-btn{display:inline-flex;align-items:center;gap:6px;padding:7px 16px;border-radius:20px;border:0.5px solid #1e3a5f;background:transparent;cursor:pointer;font-size:13px;color:var(--text-muted);margin-top:.75rem;transition:all .15s}
.back-btn:hover{border-color:#2979ff;color:#e8f0fe}
.ghost-btn{height:36px;padding:0 14px;background:transparent;border:0.5px solid #1e3a5f;border-radius:8px;cursor:pointer;font-size:13px;color:var(--text-muted);transition:all .15s}
.ghost-btn:hover{border-color:#2979ff;color:#e8f0fe}
.empty{font-size:13px;color:#3a5a7a;padding:.5rem 0}
.result-hdr{display:flex;align-items:center;gap:8px;margin-bottom:.75rem}

/* DIVIDER */
.divider{height:1px;background:linear-gradient(90deg,transparent,#1e3a5f 20%,#1e3a5f 80%,transparent);margin:.5rem 0 1rem}

/* FOOTER */
.footer{border-top:1px solid #1e3a5f;background:#061020;padding:1.75rem 1.5rem 1.5rem;display:flex;flex-direction:column;align-items:center;gap:.6rem;text-align:center}
.footer-logo-link{display:inline-block;border-radius:8px;transition:opacity .18s;line-height:0}
.footer-logo-link:hover{opacity:.8}
.footer-logo-link svg{height:44px;width:auto}
.footer-copy{font-size:11px;color:#5a7aa0;letter-spacing:.03em}
.footer-copy a{color:#5a7aa0;text-decoration:none}
.footer-copy a:hover{color:#39e07a}
</style>

