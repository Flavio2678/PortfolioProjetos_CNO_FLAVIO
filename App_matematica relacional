<script>
const DB={
  Alunos:{cols:['id','nome','cidade','nota'],rows:[[1,'Ana Lima','Florianópolis',8.5],[2,'Bruno Souza','São Paulo',6.0],[3,'Carla Neves','Florianópolis',9.2],[4,'Diego Alves','Curitiba',5.5],[5,'Eva Costa','São Paulo',7.8],[6,'Fábio Melo','Florianópolis',4.0]]},
  Cursos:{cols:['id','nome','area'],rows:[[1,'Banco de Dados','Tecnologia'],[2,'Algoritmos','Tecnologia'],[3,'Cálculo','Exatas'],[4,'Física','Exatas']]},
  Matriculas:{cols:['aluno_id','curso_id','semestre'],rows:[[1,1,'2024.1'],[1,2,'2024.1'],[2,1,'2024.1'],[2,3,'2024.1'],[3,1,'2024.1'],[3,4,'2024.1'],[4,2,'2024.1'],[5,1,'2024.1'],[5,3,'2024.1'],[6,2,'2024.1']]}
};
const opKeys=['select','project','union','intersect','diff','product','join','rename'];
let curOp='select';
const solved=new Set();
const opMeta={
  select:{sym:'σ',desc:'Filtra as linhas da relação que satisfazem uma condição.',hint:'Exemplos: nota>7  |  cidade="Florianópolis"  |  id=3'},
  project:{sym:'π',desc:'Retorna apenas as colunas especificadas (elimina duplicatas).',hint:'Exemplos: nome,nota  |  id,nome,cidade'},
  union:{sym:'∪',desc:'Retorna todas as linhas de R1 e R2, sem duplicatas. Esquemas devem ser iguais.',hint:'Selecione duas tabelas com o mesmo esquema'},
  intersect:{sym:'∩',desc:'Retorna as linhas presentes em ambas as relações.',hint:'Linhas comuns entre R1 e R2'},
  diff:{sym:'−',desc:'Retorna as linhas de R1 que não aparecem em R2.',hint:'Linhas exclusivas de R1'},
  product:{sym:'×',desc:'Combina cada linha de R1 com cada linha de R2.',hint:'Cuidado: gera n×m linhas'},
  join:{sym:'⋈',desc:'Junção natural: une as relações pelos atributos em comum.',hint:'Ex: Alunos ⋈ Matriculas (via aluno_id = id)'},
  rename:{sym:'ρ',desc:'Renomeia a relação (não altera colunas ou dados).',hint:'Ex: Estudantes — novo nome para Alunos'}
};
const exercises=[
  {id:1,title:'Seleção simples',q:'Liste os alunos com nota maior que 7.',answer:r=>r.table==='Alunos'&&r.rows.length===3,solution:'σ_nota>7(Alunos)',hint:'Use σ sobre Alunos com condição nota>7'},
  {id:2,title:'Projeção',q:'Mostre apenas o nome e a nota de todos os alunos.',answer:r=>r.cols&&r.cols.length===2&&r.cols.includes('nome')&&r.cols.includes('nota'),solution:'π_nome,nota(Alunos)',hint:'Use π escolhendo colunas nome e nota'},
  {id:3,title:'Seleção com texto',q:'Quais alunos são de Florianópolis?',answer:r=>r.table==='Alunos'&&r.rows.length===3&&r.rows.every(row=>row[2]==='Florianópolis'),solution:'σ_cidade="Florianópolis"(Alunos)',hint:'Use σ com cidade="Florianópolis"'},
  {id:4,title:'Composição',q:'Mostre apenas os nomes dos alunos de São Paulo.',answer:r=>r.cols&&r.cols.length===1&&r.cols[0]==='nome'&&r.rows.length===2,solution:'π_nome(σ_cidade="São Paulo"(Alunos))',hint:'Aplique σ primeiro, depois π'},
  {id:5,title:'Junção natural',q:'Liste todos os alunos com suas matrículas.',answer:r=>r.cols&&r.cols.includes('semestre')&&r.rows.length>=5,solution:'Alunos ⋈ Matriculas',hint:'Use ⋈ entre Alunos e Matriculas'},
];

function renderTbl(data){
  if(!data||!data.rows.length)return '<span class="empty">Nenhum resultado.</span>';
  let h='<div class="tbl-wrap"><table><thead><tr>'+data.cols.map(c=>`<th>${c}</th>`).join('')+'</tr></thead><tbody>';
  data.rows.forEach(r=>{h+=`<tr>${r.map(v=>`<td>${v}</td>`).join('')}</tr>`;});
  return h+'</tbody></table></div>';
}
function staticTbl(name){
  const d=DB[name];
  let h='<table><thead><tr>'+d.cols.map(c=>`<th>${c}</th>`).join('')+'</tr></thead><tbody>';
  d.rows.forEach(r=>{h+=`<tr>${r.map(v=>`<td>${v}</td>`).join('')}</tr>`;});
  return h+'</tbody></table>';
}
['Alunos','Cursos','Matriculas'].forEach(n=>{document.getElementById('tbl-'+n.toLowerCase()).innerHTML=staticTbl(n);});

function goTab(t){
  ['explorer','schema','exercicios'].forEach(id=>{document.getElementById('tab-'+id).style.display=id===t?'':'none';});
  document.querySelectorAll('.nav-btn').forEach((b,i)=>b.classList.toggle('active',['explorer','schema','exercicios'][i]===t));
}
function selOp(op){
  curOp=op;
  document.querySelectorAll('.op-pill').forEach((b,i)=>b.classList.toggle('active',opKeys[i]===op));
  renderForm(op);
}
function tSel(id,def){
  const keys=Object.keys(DB);
  return`<select id="${id}">${keys.map(k=>`<option${k===(def||keys[0])?' selected':''} >${k}</option>`).join('')}</select>`;
}
function renderForm(op){
  const m=opMeta[op];
  let html=`<p class="op-desc">${m.desc}</p><div class="form-row">`;
  if(op==='select')html+=tSel('sel-t')+`<input id="sel-c" placeholder="condição: ex. nota>7">`;
  else if(op==='project')html+=tSel('proj-t')+`<input id="proj-c" placeholder="colunas: ex. nome,nota">`;
  else if(['union','intersect','diff'].includes(op))html+=tSel('bin-r1')+`<span class="sym-sep">${m.sym}</span>`+tSel('bin-r2','Cursos');
  else if(op==='product')html+=tSel('prod-r1')+`<span class="sym-sep">×</span>`+tSel('prod-r2','Cursos');
  else if(op==='join')html+=tSel('join-r1')+`<span class="sym-sep">⋈</span>`+tSel('join-r2','Matriculas');
  else if(op==='rename')html+=tSel('ren-t')+`<input id="ren-n" placeholder="novo nome: ex. Estudantes">`;
  html+=`<button class="run-btn" onclick="execute()">Executar ↗</button></div>`;
  html+=`<p class="hint-txt">${m.hint}</p>`;
  document.getElementById('op-form').innerHTML=html;
}
function execute(){
  let res,expr;
  try{
    if(curOp==='select'){const t=document.getElementById('sel-t').value,c=document.getElementById('sel-c').value.trim();res=doSel(t,c);expr=`σ_${c||'?'}(${t})`;}
    else if(curOp==='project'){const t=document.getElementById('proj-t').value,cols=document.getElementById('proj-c').value.split(',').map(s=>s.trim()).filter(Boolean);res=doProj(t,cols);expr=`π_${cols.join(',')||'?'}(${t})`;}
    else if(['union','intersect','diff'].includes(curOp)){const r1=document.getElementById('bin-r1').value,r2=document.getElementById('bin-r2').value,sym=curOp==='union'?'∪':curOp==='intersect'?'∩':'−';res=doSet(r1,r2,curOp);expr=`${r1} ${sym} ${r2}`;}
    else if(curOp==='product'){const r1=document.getElementById('prod-r1').value,r2=document.getElementById('prod-r2').value;res=doProd(r1,r2);expr=`${r1} × ${r2}`;}
    else if(curOp==='join'){const r1=document.getElementById('join-r1').value,r2=document.getElementById('join-r2').value;res=doJoin(r1,r2);expr=`${r1} ⋈ ${r2}`;}
    else if(curOp==='rename'){const t=document.getElementById('ren-t').value,n=document.getElementById('ren-n').value.trim()||'NovaRelação';res=doRen(t,n);expr=`ρ_${n}(${t})`;}
    document.getElementById('expr-area').style.display='';
    document.getElementById('expr-txt').textContent=expr;
    document.getElementById('cnt-badge').innerHTML=`<span class="badge b-cnt">${res.rows.length} linha(s)</span>`;
    document.getElementById('result-out').innerHTML=renderTbl(res);
  }catch(e){document.getElementById('result-out').innerHTML=`<span class="badge b-err">${e.message}</span>`;}
}
function evalCond(row,cols,cond){
  if(!cond)return true;
  const obj={};cols.forEach((c,i)=>{obj[c]=row[i];});
  try{const expr=cond.replace(/([a-zA-Z_]+)/g,(m)=>obj.hasOwnProperty(m)?(typeof obj[m]==='string'?`"${obj[m]}"`:obj[m]):m);return Function('"use strict";return('+expr+')')();}catch(e){return false;}
}
function doSel(t,c){const d=DB[t];return{table:t,cols:[...d.cols],rows:d.rows.filter(r=>evalCond(r,d.cols,c))};}
function doProj(t,cols){
  const d=DB[t];const idxs=cols.length?cols.map(c=>d.cols.indexOf(c)).filter(i=>i>=0):d.cols.map((_,i)=>i);
  const oc=idxs.map(i=>d.cols[i]),rows=d.rows.map(r=>idxs.map(i=>r[i]));
  const seen=new Set();return{cols:oc,rows:rows.filter(r=>{const k=JSON.stringify(r);if(seen.has(k))return false;seen.add(k);return true;})};
}
function rk(r){return JSON.stringify(r);}
function doSet(t1,t2,op){
  const d1=DB[t1],d2=DB[t2];
  if(JSON.stringify(d1.cols)!==JSON.stringify(d2.cols))throw new Error('As relações precisam ter o mesmo esquema.');
  const s2=new Set(d2.rows.map(rk));let rows;
  if(op==='union'){const seen=new Set();rows=[...d1.rows,...d2.rows].filter(r=>{const k=rk(r);if(seen.has(k))return false;seen.add(k);return true;});}
  else if(op==='intersect')rows=d1.rows.filter(r=>s2.has(rk(r)));
  else rows=d1.rows.filter(r=>!s2.has(rk(r)));
  return{cols:[...d1.cols],rows};
}
function doProd(t1,t2){
  const d1=DB[t1],d2=DB[t2],cols=[...d1.cols.map(c=>t1+'.'+c),...d2.cols.map(c=>t2+'.'+c)],rows=[];
  d1.rows.forEach(r1=>d2.rows.forEach(r2=>rows.push([...r1,...r2])));
  return{cols,rows};
}
function doJoin(t1,t2){
  const d1=DB[t1],d2=DB[t2],com=d1.cols.filter(c=>d2.cols.includes(c));
  if(!com.length)return doProd(t1,t2);
  const i1=com.map(c=>d1.cols.indexOf(c)),i2=com.map(c=>d2.cols.indexOf(c));
  const oc=[...d1.cols,...d2.cols.filter(c=>!com.includes(c))];
  const ex=d2.cols.map((_,i)=>i).filter(i=>!i2.includes(i)),rows=[];
  d1.rows.forEach(r1=>d2.rows.forEach(r2=>{if(i1.every((x,k)=>r1[x]==r2[i2[k]]))rows.push([...r1,...ex.map(i=>r2[i])]);} ));
  return{cols:oc,rows};
}
function doRen(t,n){const d=DB[t];return{cols:[...d.cols],rows:d.rows.map(r=>[...r]),_name:n};}
function evalExpr(s){
  s=s.trim();
  const jm=s.match(/^(\w+)\s*⋈\s*(\w+)$/);if(jm)return doJoin(jm[1],jm[2]);
  const pm=s.match(/^π_([^(]+)\((.+)\)$/);
  if(pm){const cols=pm[1].split(',').map(x=>x.trim()),inner=evalExpr(pm[2]);const idxs=cols.map(c=>inner.cols.indexOf(c)).filter(i=>i>=0),oc=idxs.map(i=>inner.cols[i]),rows=inner.rows.map(r=>idxs.map(i=>r[i]));const seen=new Set();return{cols:oc,rows:rows.filter(r=>{const k=JSON.stringify(r);if(seen.has(k))return false;seen.add(k);return true;})};}
  const sm=s.match(/^σ_([^(]+)\((.+)\)$/);if(sm){const inner=evalExpr(sm[2]);return{...inner,rows:inner.rows.filter(r=>evalCond(r,inner.cols,sm[1]))};}
  if(DB[s])return{table:s,cols:[...DB[s].cols],rows:[...DB[s].rows]};
  throw new Error('Expressão não reconhecida: '+s);
}

const exList=document.getElementById('exer-list');
exercises.forEach(ex=>{
  const d=document.createElement('div');
  d.className='exer-item'+(solved.has(ex.id)?' solved':'');
  d.id='ei-'+ex.id;
  d.innerHTML=`<div class="exer-num${solved.has(ex.id)?' done':''}">${solved.has(ex.id)?'✓':ex.id}</div><div class="exer-info"><div class="exer-title">${ex.title}</div><div class="exer-sub">${ex.q}</div></div><span class="arr">›</span>`;
  d.onclick=()=>openExer(ex);
  exList.appendChild(d);
});
function openExer(ex){
  document.getElementById('exer-list').style.display='none';
  document.getElementById('exer-detail').style.display='';
  document.getElementById('exer-q').textContent=ex.id+'. '+ex.q;
  document.getElementById('exer-hint').innerHTML='<strong style="font-weight:500;color:#6b8cba">Dica:</strong> '+ex.hint;
  document.getElementById('exer-input').value='';
  document.getElementById('exer-feedback').innerHTML='';
  document.getElementById('exer-input').dataset.id=ex.id;
}
function checkExer(){
  const inp=document.getElementById('exer-input').value.trim();
  const id=parseInt(document.getElementById('exer-input').dataset.id);
  const ex=exercises.find(e=>e.id===id);
  let res;
  try{res=evalExpr(inp);}catch(e){document.getElementById('exer-feedback').innerHTML=`<span class="badge b-err">Erro: ${e.message}</span>`;return;}
  if(ex.answer(res)){
    solved.add(id);
    document.getElementById('exer-feedback').innerHTML=`<span class="badge b-ok" style="margin-bottom:.6rem;display:inline-block">Correto! Muito bem.</span>`+renderTbl(res);
    const card=document.getElementById('ei-'+id);
    if(card){card.className='exer-item solved';card.querySelector('.exer-num').className='exer-num done';card.querySelector('.exer-num').textContent='✓';}
  }else{
    document.getElementById('exer-feedback').innerHTML=`<span class="badge b-err" style="margin-bottom:.6rem;display:inline-block">Resultado incorreto, tente novamente.</span>`+renderTbl(res);
  }
}
function showAnswer(){
  const id=parseInt(document.getElementById('exer-input').dataset.id);
  document.getElementById('exer-input').value=exercises.find(e=>e.id===id).solution;
  document.getElementById('exer-feedback').innerHTML='<span style="font-size:12px;color:#3a5a7a;font-style:italic">Resposta exibida. Clique em Verificar para confirmar.</span>';
}
function backToList(){document.getElementById('exer-list').style.display='';document.getElementById('exer-detail').style.display='none';}
renderForm('select');
</script>
